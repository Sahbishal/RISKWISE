# RISKWISE Environment Configuration
# Dual Engine Mode: If Snowflake credentials are omitted, system automatically operates on embedded SQLite engine.

# FastAPI Backend Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Snowflake Database Credentials (Optional for live Snowflake deployment)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=RISKWISE_ANALYST
SNOWFLAKE_PASSWORD=YourSecurePassword123!
SNOWFLAKE_DATABASE=RISKWISE_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ANALYST_ROLE

# AI Copilot & Cortex Configuration
CORTEX_MODEL=mistral-large2
CORTEX_EMBEDDING_MODEL=e5-base-v2
